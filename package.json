    "db:studio": "prisma studio",
    "perf:benchmark": "node scripts/performance/api-benchmark.mjs",
    "perf:fixture": "tsx scripts/performance/synthetic-catalog-fixture.ts",
    "perf:bundle": "node scripts/performance/bundle-report.mjs",
    "perf:explain": "tsx scripts/performance/explain-catalog.ts",
    "perf:config": "node scripts/performance/config-check.mjs",
    "perf:browser": "node scripts/performance/browser-trace.mjs",
    "perf:db-telemetry": "node scripts/performance/db-telemetry.mjs",
    "db:migrate:empty-check": "node scripts/performance/migration-chain-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
