# Runtime connection, such as the Supabase transaction-mode pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/pharmacy_management?schema=public"

# Session/direct connection used only by Prisma CLI and migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_management?schema=public"
# Public application origin; do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only authentication pepper. Generate with: openssl rand -hex 32
AUTH_PEPPER="replace-with-at-least-32-random-characters"
